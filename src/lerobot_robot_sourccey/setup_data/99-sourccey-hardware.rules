# Sourccey hardware USB port mapping

# Servo drivers
SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-1000110000.pcie-pci-0001:01:00.0-usb-0:1.3:1.0", ENV{ID_MM_DEVICE_IGNORE}="1", MODE:="0666", SYMLINK+="robotRightArm"
SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-1000110000.pcie-pci-0001:01:00.0-usb-0:1.4:1.0", ENV{ID_MM_DEVICE_IGNORE}="1", MODE:="0666", SYMLINK+="robotLeftArm"

# Wrist cameras
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", ATTR{index}=="0", ENV{ID_PATH}=="platform-xhci-hcd.0-usb-0:1:1.0", SYMLINK+="cameraWristRight"
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", ATTR{index}=="0", ENV{ID_PATH}=="platform-xhci-hcd.1-usb-0:2:1.0", SYMLINK+="cameraWristLeft"

# Front cameras
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", ATTR{index}=="0", ENV{ID_PATH}=="platform-xhci-hcd.1-usb-0:1:1.0", SYMLINK+="cameraFrontRight"
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", ATTR{index}=="0", ENV{ID_PATH}=="platform-xhci-hcd.0-usb-0:2:1.0", SYMLINK+="cameraFrontLeft"
SUBSYSTEM=="video4linux", KERNEL=="video*", ENV{ID_PATH}=="platform-1000110000.pcie-pci-0001:01:00.0-usb-0:1.2.1:1.0", ENV{ID_V4L_CAPABILITIES}==":capture:", ATTR{index}=="0", SYMLINK+="cameraFrontBottom"

# Front lidar
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ENV{ID_SERIAL}=="Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001", ENV{ID_PATH}=="platform-1000110000.pcie-pci-0001:01:00.0-usb-0:1.2.2:1.0", SYMLINK+="lidarFront"
